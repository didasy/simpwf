{
  "name": "e2e",
  "content": {
    "start_node_id": "11111111-1111-7111-8111-111111111101",
    "keys": {
      "manager": "11111111-1111-7111-8111-111111111103",
      "staff": "11111111-1111-7111-8111-111111111104"
    },
    "nodes": [
      {
        "type": "script",
        "id": "11111111-1111-7111-8111-111111111101",
        "name": "Load Profile",
        "input_data": "user",
        "script": "if (!context.user) { return { ok: false, error: 'no user' }; }\nreturn { ok: true, name: context.user.name, title: context.user.title };",
        "timeout": "30s",
        "output_property": "profile",
        "next_node": "11111111-1111-7111-8111-111111111102"
      },
      {
        "type": "conditions",
        "id": "11111111-1111-7111-8111-111111111102",
        "name": "Route by Title",
        "conditions": [
          {"key": "manager", "condition": "return context.profile.title === 'Manager';"},
          {"key": "staff", "condition": "return context.profile.title === 'Staff';"},
          {"condition": "return context.profile.title !== 'Manager' && context.profile.title !== 'Staff';"}
        ]
      },
      {
        "type": "input",
        "id": "11111111-1111-7111-8111-111111111103",
        "name": "Manager Approval",
        "channel": "http",
        "output_property": "approval",
        "next_node": "11111111-1111-7111-8111-111111111107"
      },
      {
        "type": "script",
        "id": "11111111-1111-7111-8111-111111111104",
        "name": "Staff Path",
        "script": "return {\n  user_id: null,\n  input_data: { approved: true, by: 'staff' }\n};",
        "output_property": "approval",
        "next_node": "11111111-1111-7111-8111-111111111107"
      },
      {
        "type": "script",
        "id": "11111111-1111-7111-8111-111111111107",
        "name": "Finalize",
        "script": "return { done: true, at: new Date().toISOString() };",
        "output_property": "final"
      }
    ]
  }
}
