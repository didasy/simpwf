# SimpWF environment variables. These mirror config.yaml keys; the app
# consults them only when no config file is present. Copy to .env when
# running via docker-compose (compose loads it automatically).

# HTTP listen address for the API and dispatcher.
SIMPWF_INFRA_HTTP_HOST=localhost:9999
# Expose Swagger UI at /swagger/index.html.
SIMPWF_INFRA_HTTP_SWAGGER_ENABLED=true

# PostgreSQL DSN (pgx/postgres wire format).
SIMPWF_INFRA_POSTGRESQL_DSN=host=localhost user=gorm password=gorm dbname=gorm port=9921 sslmode=disable
# PostgreSQL pool ceiling (per replica). Exhaustion degrades to latency, not
# errors; size max_open_conns ≈ (engine workers × peak queries per
# transition) + headroom, divided across expected replicas.
SIMPWF_INFRA_POSTGRESQL_MAX_OPEN_CONNS=25
SIMPWF_INFRA_POSTGRESQL_MAX_IDLE_CONNS=25
SIMPWF_INFRA_POSTGRESQL_CONN_MAX_LIFETIME=5m
SIMPWF_INFRA_POSTGRESQL_CONN_MAX_IDLE_TIME=5m

# Optional brokers. Empty DSN disables the transport; a configured but
# unreachable broker fails startup.
SIMPWF_INFRA_REDIS_DSN=
SIMPWF_INFRA_RABBITMQ_DSN=
# RabbitMQ durable queue names (defaults when unset).
SIMPWF_INFRA_RABBITMQ_INPUT_QUEUE=simpwf.input
SIMPWF_INFRA_RABBITMQ_OUTPUT_QUEUE=simpwf.output
SIMPWF_INFRA_RABBITMQ_STATUS_QUEUE=simpwf.status

# ants worker pool.
SIMPWF_WORKER_POOL_SIZE=100
SIMPWF_WORKER_EXPIRY_DURATION=5m
SIMPWF_WORKER_MAX_BLOCKING_TASKS=16
SIMPWF_WORKER_PRE_ALLOC=false
SIMPWF_WORKER_NON_BLOCKING=false
SIMPWF_WORKER_DISABLE_PURGE=false

# Engine limits (Go duration strings).
SIMPWF_ENGINE_DEFAULT_NODE_TIMEOUT=30s
SIMPWF_ENGINE_MAX_NODE_TIMEOUT=5m
SIMPWF_ENGINE_CONDITION_TIMEOUT=5s
SIMPWF_ENGINE_MAX_PER_NODE_EXECUTIONS=100
SIMPWF_ENGINE_MAX_TOTAL_EXECUTIONS=1000
SIMPWF_ENGINE_LEASE_DURATION=30s
SIMPWF_ENGINE_CLAIM_BATCH_SIZE=10
SIMPWF_ENGINE_MAX_OUTPUT_BYTES=1048576
SIMPWF_ENGINE_MAX_REDIRECTS=5
# Comma-separated allowlist of http(s) targets for external HTTP nodes.
# openrouter.ai is required by the openrouter and jev custom nodes.
SIMPWF_ENGINE_HTTP_ALLOWLIST=http://127.0.0.1:8080,openrouter.ai
# Comma-separated allowlist of executables for command nodes. Entries must be
# absolute paths; bare names fail startup.
SIMPWF_ENGINE_EXEC_ALLOWLIST=/bin/echo,/bin/ls
# Broker input consumer supervision (see config.yaml engine.consumer_retry).
SIMPWF_ENGINE_CONSUMER_RETRY_MAX_ATTEMPTS=3
SIMPWF_ENGINE_CONSUMER_RETRY_INITIAL_BACKOFF=1s
SIMPWF_ENGINE_CONSUMER_RETRY_MAX_BACKOFF=30s
SIMPWF_ENGINE_CONSUMER_RETRY_MIN_HEALTHY_RUN=30s

# API token authentication. When enabled, every /v1 endpoint requires the
# X-Api-Token header. A valid token authenticates the service principal,
# which bypasses every authorization gate; treat it as a machine credential.
# /health/* and GET /v1/auth/config stay public.
SIMPWF_AUTH_ENABLED=false
SIMPWF_API_TOKEN=

# OIDC resource server. The engine keeps no sessions and no callback: the
# frontend runs code+PKCE against the provider and calls the API with
# Authorization: Bearer <JWT>. The frontend reads issuer, client_id, the
# endpoints, and the roles claim from GET /v1/auth/config.
SIMPWF_AUTH_OIDC_ENABLED=false
SIMPWF_AUTH_OIDC_ISSUER=
SIMPWF_AUTH_OIDC_CLIENT_ID=
# Expected aud claim; empty falls back to the client id.
SIMPWF_AUTH_OIDC_AUDIENCE=
# Claim carrying the caller's roles.
SIMPWF_AUTH_OIDC_ROLES_CLAIM=roles
# Claim used as the display name; falls back to preferred_username then email.
SIMPWF_AUTH_OIDC_USERNAME_CLAIM=name
# Tolerance for clock drift on exp only; nbf still rejects a token issued
# ahead of this clock.
SIMPWF_AUTH_OIDC_CLOCK_SKEW=1m
# How long a fetched JWKS stays fresh. This also bounds how often the
# provider is contacted: a rejected token never forces its own fetch.
# Values below 1m are clamped to 1m.
SIMPWF_AUTH_OIDC_CACHE_TTL=5m

# Role catalog as JSON object of role name to action list. Empty keeps the
# file/default catalog; a set value overrides the config file. Must stay
# valid JSON or the app fails startup with
# `configuration: SIMPWF_AUTH_ROLE_PERMISSIONS: invalid JSON`.
# Example:
#SIMPWF_AUTH_ROLE_PERMISSIONS={"admin":["definitions:read","roles:read"],"finance":["instances:read"]}
SIMPWF_AUTH_ROLE_PERMISSIONS=

# OpenRouter API key for the openrouter and jev custom nodes. It is
# snapshotted into each instance context at creation and referenced as
# {{ env.SIMPWF_OPENROUTER_KEY }}. Keep this value out of committed files.
#SIMPWF_OPENROUTER_KEY=

# System audit actor.
SIMPWF_SYSTEM_USER_ID=00000000-0000-7000-8000-000000000001
SIMPWF_SYSTEM_NAME=system
SIMPWF_SYSTEM_EMAIL=system@localhost

# S3-compatible storage for the s3fetch example custom node. Only SIMPWF_*
# vars are visible to workflows, snapshotted at instance creation under the
# reserved env root (address as {{ env.SIMPWF_S3_ENDPOINT }} etc.).
# Local compose runs RustFS (rustfs/rustfs) with these dev credentials and
# plain HTTP; match with "use_ssl": false in the s3fetch config.
#SIMPWF_S3_ENDPOINT=localhost:9000
#SIMPWF_S3_ACCESS_KEY=rustfsadmin
#SIMPWF_S3_SECRET_KEY=rustfsadmin
